// Aurora Shaders for Hytale - sky-derived ambient light.
// The sky, as whichever atmosphere model draws it, reduced to an ambient cube: the light that
// reaches a surface facing each of the six axis directions. The deferred pass's vertex shader
// (ScreenVS, generated by tools/prepare_shaders) works it out once per draw - three vertices -
// and hands it over as flat varyings; a surface blends the six faces by its normal. The ground
// below the horizon passes on part of the sky light it gets. Sunlight itself stays the direct
// light and the GI's job, so it is not in the cube (no glare, no sun disc).

#ifndef AU_SKY_LIGHT
#define AU_SKY_LIGHT

#include "AU_Sky.glsl"

#ifndef AU_SKY_LIGHT_GROUND
#define AU_SKY_LIGHT_GROUND 0.35   // ground albedo for the light bounced up from below the horizon
#endif
#define AU_SKY_LIGHT_SAMPLES 48

// Faces: +x, -x, +y, -y, +z, -z.
void AU_SkyLightCube(out vec3 cube[6])
{
    for (int face = 0; face < 6; face++) cube[face] = vec3(0.0);
    for (int i = 0; i < AU_SKY_LIGHT_SAMPLES; i++) {
        // Upper hemisphere in equal solid angles (height uniform), golden-angle azimuths.
        float y = 1.0 - (float(i) + 0.5) / float(AU_SKY_LIGHT_SAMPLES);
        float r = sqrt(max(1.0 - y * y, 0.0));
        float a = float(i) * 2.39996323;
        vec3 d = vec3(r * cos(a), y, r * sin(a));
        vec3 radiance = GetSky(d.y, dot(d, sunVec), 0.5, false, false);
        cube[0] += radiance * max(d.x, 0.0);
        cube[1] += radiance * max(-d.x, 0.0);
        cube[2] += radiance * d.y;
        cube[4] += radiance * max(d.z, 0.0);
        cube[5] += radiance * max(-d.z, 0.0);
    }
    for (int face = 0; face < 6; face++) cube[face] *= 6.2831853 / float(AU_SKY_LIGHT_SAMPLES);
    // The ground: even radiance (its albedo x the sky light on it / pi) over the lower
    // hemisphere - all of it reaches a downward face, half of it a wall.
    vec3 ground = cube[2] * clamp(AU_SKY_LIGHT_GROUND, 0.0, 1.0);
    cube[3] += ground;
    cube[0] += ground * 0.5;
    cube[1] += ground * 0.5;
    cube[4] += ground * 0.5;
    cube[5] += ground * 0.5;
}

#if AU_SKY_LIGHTING == 1
#ifdef AU_SKY_LIGHT_VERTEX
flat out vec3 auSkyLightCube[6];
void AU_SkyLightVertex()
{
    AU_InitCommon();
    AU_SkyLightCube(auSkyLightCube);
}
#endif
#else
void AU_SkyLightVertex() {}
#endif

// Set by the pass that has the cube (DeferredFS); everything else keeps the classic fill.
vec3 auSkyCube[6];
bool auSkyCubeValid = false;
// GTAO's bent normal (DeferredFS): the direction the sky is actually open from.
vec3 auSkyNormal = vec3(0.0, 1.0, 0.0);
bool auSkyNormalValid = false;

// Ambient light for a surface from the sky cube, at the brightness of the existing ambient:
// a surface facing straight up gets `ambient`'s luminance, everything else what the sky gives
// it relative to that, in the sky's hue (kept within bounds, like the classic fill).
vec3 AU_SkyAmbient(vec3 ambient, vec3 normal, int subsurfaceMode)
{
    vec3 n2 = normal * normal;
    vec3 sky = n2.x * (normal.x >= 0.0 ? auSkyCube[0] : auSkyCube[1])
             + n2.y * (normal.y >= 0.0 ? auSkyCube[2] : auSkyCube[3])
             + n2.z * (normal.z >= 0.0 ? auSkyCube[4] : auSkyCube[5]);
    // Grass and leaves scatter light through themselves: half way to the all-round average.
    if (subsurfaceMode == 1 || subsurfaceMode == 2) {
        vec3 average = (auSkyCube[0] + auSkyCube[1] + auSkyCube[2] + auSkyCube[3] + auSkyCube[4] + auSkyCube[5]) / 6.0;
        sky = mix(sky, average, 0.5);
    }
    float luminance = GetLuminance(sky);
    vec3 tint = clamp(sky / max(luminance, 1e-6), vec3(0.6), vec3(1.6));
    tint /= max(GetLuminance(tint), 1e-6);
    return tint * (luminance * GetLuminance(ambient) / max(GetLuminance(auSkyCube[2]), 1e-6));
}

#endif // AU_SKY_LIGHT
